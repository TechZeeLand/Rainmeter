; Column 6 (Friday) - Red
InlinePattern=(.{4})(?=.{4}\n)|(.{4})(?=.{4}$)
InlineSetting=Color | ff0000

; Column 7 (Saturday) - Red
InlinePattern2=(.{3})(?=\n)|(.{3})$
InlineSetting2=Color | ff0000

; Spacing Logic for Single Digits
InlinePattern3=(?<=\b[1-9])\x20
InlineSetting3=Size | 12.5
InlinePattern4=\x20(?=[1-9]\b)
InlineSetting4=Size | 12.5
InlinePattern5=(?<=^|\n)\x20
InlineSetting5=Size | 12.5

; Previous/Next Month Days - Gray
InlinePattern6=(^.*?(?= 1))
InlineSetting6=Color | aaaaaa
InlinePattern7=(?:.*\n){4}.*?( 1[\s\S]*)
