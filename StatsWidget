; --- Current Day Highlight ---
; Placed BEFORE MeterDays so the number is drawn ON TOP of the red box.

[MeasureDate]
Measure=Time
Format=%#d

[MeasureDateToday]
Measure=Time
Format=%#d

[MeasureDayOfWeekToday]
Measure=Time
Format=%w

; April 2026 starts on a Wednesday (Day 3). 
; This formula calculates which row (0-5) the date falls in.
[MeasureRowCalculation]
Measure=Calc
Formula=(Trunc(([MeasureDateToday] + 3 - 1) / 7))
DynamicVariables=1

[MeasureCurrentDayX]
Measure=Calc
Formula=([MeasureDayOfWeekToday] * 37.8)
DynamicVariables=1

[MeasureCurrentDayY]
Measure=Calc
Formula=([MeasureRowCalculation] * 23.8)
DynamicVariables=1

