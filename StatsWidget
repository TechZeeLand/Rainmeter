Plugin=WebParser
URL=[MeasureStats]
StringIndex=1

[MeasureCPUTemp]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=2

[MeasureRAM]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=3

[MeasureRaidTotal]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=10

[MeasureRaidUsed]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=9

; -------- RAW TOTAL BYTES --------

[MeasureNetDownRaw]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=12
OnUpdateAction=[!UpdateMeasure MeasureNetDownMbps][!SetVariable NetDownOld [MeasureNetDownRaw]]

[MeasureNetUpRaw]
Measure=Plugin
Plugin=WebParser
URL=[MeasureStats]
StringIndex=13
OnUpdateAction=[!UpdateMeasure MeasureNetUpMbps][!SetVariable NetUpOld [MeasureNetUpRaw]]


; -------- STORE PREVIOUS TOTALS --------

[MeasureNetDownOld]
Measure=Calc
Formula=MeasureNetDownRaw
UpdateDivider=-1

[MeasureNetUpOld]
Measure=Calc
Formula=MeasureNetUpRaw
UpdateDivider=-1


; -------- SPEED (Mbps) --------

[MeasureNetDownMbps]
Measure=Calc
Formula=((MeasureNetDownRaw - MeasureNetDownOld) * 8) / (1000000 * #UPDATEINTERVAL#/1000)
DynamicVariables=1

[MeasureNetUpMbps]
Measure=Calc
Formula=((MeasureNetUpRaw - MeasureNetUpOld) * 8) / (1000000 * #UPDATEINTERVAL#/1000)
DynamicVariables=1

[Variables]
NetDownOld=0
NetUpOld=0




